{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/hq/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/hq",
      "destination": "/hq/index.html"
    },
    {
      "source": "/hq/",
      "destination": "/hq/index.html"
    },
    {
      "source": "/practice",
      "destination": "/practice-planner.html"
    },
    {
      "source": "/school",
      "destination": "/api/school-form"
    },
    {
      "source": "/gear",
      "destination": "/api/gear-form"
    },
    {
      "source": "/kickoff",
      "destination": "/api/kickoff-form"
    },
    {
      "source": "/team-parent",
      "destination": "/api/team-parent-form"
    },
    {
      "source": "/commitment",
      "destination": "/api/commitment-form"
    },
    {
      "source": "/photos",
      "destination": "/api/photo-form"
    },
    {
      "source": "/logos",
      "destination": "/logos.html"
    },
    {
      "source": "/privates",
      "destination": "/api/privates-form"
    },
    {
      "source": "/poll",
      "destination": "/api/poll-form"
    },
    {
      "source": "/coach-guide",
      "destination": "/coach-guide.html"
    },
    {
      "source": "/global",
      "destination": "/api/global-form"
    },
    {
      "source": "/dssc-texts",
      "destination": "/api/dssc-texts-form"
    },
    {
      "source": "/stats",
      "destination": "/api/stats-form"
    },
    {
      "source": "/meet",
      "destination": "/api/global-meeting"
    },
    {
      "source": "/hub",
      "destination": "/api/hub"
    },
    {
      "source": "/courts",
      "destination": "/api/courts-public"
    },
    {
      "source": "/reach",
      "destination": "/reach/index.html"
    },
    {
      "source": "/reach/",
      "destination": "/reach/index.html"
    },
    {
      "source": "/reach/api/:path*",
      "destination": "/api/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/board",
      "destination": "/reach",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/email-schedule",
      "schedule": "5 * * * *"
    },
    {
      "path": "/api/projects-weekly",
      "schedule": "0 13 * * 1"
    },
    {
      "path": "/api/sportsyou-reminders",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/comm-reminders",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/open-shifts",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/hours-approval-reminder",
      "schedule": "0 15 * * 1"
    },
    {
      "path": "/api/dssc-plan-reminder",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/aes-poll",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/daily-changelog",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/gear-reminders",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/dssc-shifts",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/reimbursement-report",
      "schedule": "30 12 * * 1"
    },
    {
      "path": "/api/travel-gap-alert",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/kickoff-chase",
      "schedule": "0 14 * * 6"
    },
    {
      "path": "/api/photo-digest",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/playbook-programs",
      "schedule": "30 12 * * *"
    },
    {
      "path": "/api/playbook-calendar",
      "schedule": "5 * * * *"
    },
    {
      "path": "/api/playbook-registrations",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/privates-ask",
      "schedule": "0 15 25 * *"
    },
    {
      "path": "/api/checkin-reminder",
      "schedule": "0 14 * * 1"
    },
    {
      "path": "/api/weekly-schedule",
      "schedule": "0 15 * * 6"
    },
    {
      "path": "/api/day-schedule",
      "schedule": "0 14 * * 6"
    },
    {
      "path": "/api/sms-campaigns",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/tournament-sync",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/registration-check",
      "schedule": "30 13 * * *"
    },
    {
      "path": "/api/dssc-coach-texts?utc=17",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/dssc-coach-texts?utc=18",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/clinic-reminders?utc=17",
      "schedule": "5 17 * * *"
    },
    {
      "path": "/api/clinic-reminders?utc=18",
      "schedule": "5 18 * * *"
    },
    {
      "path": "/api/staff-clock-reminder",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/site-report",
      "schedule": "0 14 1 * *"
    },
    {
      "path": "/api/site-inbox-poll",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/marketing-cron",
      "schedule": "*/15 * * * *"
    }
  ],
  "functions": {
    "api/projects.js": {
      "maxDuration": 120
    },
    "api/projects-weekly.js": {
      "maxDuration": 120
    },
    "api/playbook-calendar.js": {
      "maxDuration": 120
    },
    "api/court-availability.js": {
      "maxDuration": 60
    },
    "api/tournament-sync.js": {
      "maxDuration": 120
    },
    "api/tournament-feed.js": {
      "maxDuration": 120
    },
    "api/registration-check.js": {
      "maxDuration": 300
    },
    "api/sms-campaigns.js": {
      "maxDuration": 300
    },
    "api/ask-hq.js": {
      "maxDuration": 120
    },
    "api/courts-public.js": {
      "maxDuration": 60
    },
    "api/marketing.js": {
      "maxDuration": 120
    },
    "api/marketing-cron.js": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/(kit|brief)-(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
